# Copy to .env (local) or set in Vercel Project Settings → Environment Variables.
# If unset, the app falls back to the project's committed literals in
# services/supabaseClient.ts (local dev convenience only — prefer env vars).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-starting-with-eyJ

# ---------------------------------------------------------------------------
# Load test (scripts/loadTest.ts) — `npm run loadtest`.
# NEVER point LOAD_EVENT_ID at a production event: the test writes check-ins.
# `npm run loadtest:selftest` validates the harness with no database at all.
# ---------------------------------------------------------------------------
# LOAD_EVENT_ID=00000000-0000-0000-0000-000000000000
# LOAD_EMAIL=officer@your-domain.org
# LOAD_PASSWORD=...
# LOAD_CONFIRM=yes
# LOAD_CONCURRENCY=150
# LOAD_DURATION_S=180
# LOAD_POOL_SIZE=200
# LOAD_THINK_MIN_MS=400
# LOAD_THINK_MAX_MS=1600
# LOAD_ALLOW_ANY_EVENT=no
# LOAD_JSON_OUT=loadtest-report.json